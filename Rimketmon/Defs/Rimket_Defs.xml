<Defs>

  <!-- 가상현실 신경 과부하: 뇌에 가해지는 전용 피해. 출혈 없음, 방어구 무시 -->
  <DamageDef>
    <defName>RimketNeuralOverload</defName>
    <label>neural overload</label>
    <workerClass>DamageWorker_AddInjury</workerClass>
    <externalViolence>false</externalViolence>
    <hasForcefulImpact>false</hasForcefulImpact>
    <makesBlood>false</makesBlood>
    <canInterruptJobs>false</canInterruptJobs>
    <harmsHealth>true</harmsHealth>
    <deathMessage>{0}의 뇌가 가상현실 신경 과부하로 파괴되었다.</deathMessage>
    <hediff>RimketNeuralInjury</hediff>
    <impactSoundType>Blunt</impactSoundType>
  </DamageDef>

  <HediffDef ParentName="InjuryBase">
    <defName>RimketNeuralInjury</defName>
    <label>neural overload</label>
    <labelNoun>a neural overload injury</labelNoun>
    <description>림볼의 가상현실 전투 중 신경계에 가해진 과부하 손상.</description>
    <comps>
      <li Class="HediffCompProperties_TendDuration">
        <labelTendedWell>treated</labelTendedWell>
        <labelTendedWellInner>treated</labelTendedWellInner>
        <labelSolidTendedWell>treated</labelSolidTendedWell>
      </li>
      <li Class="HediffCompProperties_GetsPermanent">
        <permanentLabel>neural scar</permanentLabel>
        <instantlyPermanentLabel>permanent neural damage</instantlyPermanentLabel>
      </li>
    </comps>
    <injuryProps>
      <painPerSeverity>0.01</painPerSeverity>
      <averagePainPerSeverityPermanent>0.005</averagePainPerSeverityPermanent>
      <bleedRate>0</bleedRate>
      <canMerge>true</canMerge>
      <destroyedLabel>Destroyed</destroyedLabel>
      <destroyedOutLabel>Destroyed</destroyedOutLabel>
    </injuryProps>
  </HediffDef>

