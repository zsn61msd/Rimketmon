    <maxSimultaneous>1</maxSimultaneous>
    <subSounds>
      <li>
        <onCamera>True</onCamera>
        <grains>
          <li Class="AudioGrain_Clip"><clipPath>Rimket/BattleVictory</clipPath></li>
        </grains>
        <volumeRange>60~60</volumeRange>
        <sustainLoop>False</sustainLoop>
        <sustainAttack>0.1</sustainAttack>
        <sustainRelease>0.3</sustainRelease>
      </li>
    </subSounds>
  </SoundDef>

